# 🔧 Firebase 配置环境变量示例文件
# 复制此文件为 .env 并填入你的Firebase项目配置信息

# ========================================
# Firebase 核心配置 (必填)
# ========================================

# Firebase API密钥
REACT_APP_FIREBASE_API_KEY=your-firebase-api-key

# Firebase认证域名  
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Firebase项目ID
REACT_APP_FIREBASE_PROJECT_ID=your-project-id

# Firebase存储桶
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Firebase消息发送者ID
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Firebase应用ID
REACT_APP_FIREBASE_APP_ID=your-app-id

# Firebase分析ID (可选)
REACT_APP_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ========================================
# 应用配置
# ========================================

# Node.js 兼容性配置
NODE_OPTIONS=--openssl-legacy-provider

# 环境模式 (development/production)
REACT_APP_ENVIRONMENT=development

# 调试模式 (true/false)
REACT_APP_DEBUG_MODE=true

# 是否使用 Firebase 模拟器 (true/false)
REACT_APP_USE_EMULATOR=false

# ========================================
# 网站配置 (可选自定义)
# ========================================

# 网站名称
NEXT_PUBLIC_SITE_NAME="美食外卖"

# 网站描述
NEXT_PUBLIC_SITE_DESCRIPTION="美味食品在线订购平台"

# ========================================
# API 配置
# ========================================

# 开发环境
NODE_ENV=development

# API地址
REACT_APP_API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ========================================
# 功能开关 (可选)
# ========================================

# 启用实时更新 (true/false)
REACT_APP_ENABLE_REALTIME=true

# 启用缓存系统 (true/false)  
REACT_APP_ENABLE_CACHE=true

# 启用离线模式 (true/false)
REACT_APP_ENABLE_OFFLINE=true

# ========================================
# Firebase 配置说明
# ========================================
# 1. 访问 https://console.firebase.google.com/
# 2. 创建新项目或选择现有项目
# 3. 启用 Firestore Database
# 4. 在项目设置中找到 "网络应用" 配置
# 5. 复制配置值到上面对应的环境变量中
# 6. 将此文件复制为 .env 文件
# 7. 不要将包含真实配置的 .env 文件提交到版本控制

# ========================================
# Firestore 数据库结构说明
# ========================================

# dishes (菜品集合)
#   - id: 菜品ID (自动生成)
#   - title: 菜品名称  
#   - price: 价格 (数字)
#   - category: 分类ID (字符串)
#   - desc: 描述 (字符串)
#   - image01: 图片URL (字符串)
#   - options: 选项配置对象
#   - available: 是否可用 (布尔值)
#   - featured: 是否推荐 (布尔值)
#   - createdAt: 创建时间 (时间戳)
#   - updatedAt: 更新时间 (时间戳)

# categories (分类集合)
#   - id: 分类ID (字符串)
#   - name: 分类名称 (字符串)
#   - icon: 图标类名 (字符串)
#   - order: 排序序号 (数字)
#   - createdAt: 创建时间 (时间戳)
#   - updatedAt: 更新时间 (时间戳)

# orders (订单集合)
#   - id: 订单ID (自动生成)
#   - customerInfo: 客户信息 (对象)
#   - items: 订单项目数组 (数组)
#   - totalAmount: 总金额 (数字)
#   - status: 订单状态 (字符串)
#   - createdAt: 创建时间 (时间戳)
#   - updatedAt: 更新时间 (时间戳)

# ========================================
# 快速开始步骤
# ========================================
# 1. 复制此文件: cp .env.example .env
# 2. 填入Firebase配置信息
# 3. 运行: npm install  
# 4. 启动应用: npm start
# 5. 应用会自动初始化示例数据